#!/usr/bin/env bash
set -Eeuo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

print_status() {
    echo
    echo "===== Abschlussstatus ====="
    git status --short --branch
}
trap print_status EXIT

echo "===== Git-Diff prüfen ====="
git diff --check
git diff --cached --check

echo
echo "===== Build und Tests ====="
scripts/build-project

if ! command -v node >/dev/null 2>&1; then
    echo "Node.js 22+ ist für die Dashboard-Tests erforderlich." >&2
    exit 1
fi
npm test
