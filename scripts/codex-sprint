#!/usr/bin/env bash
set -Eeuo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

BOOTSTRAP=false
if [[ "${1:-}" == "--bootstrap" ]]; then
    BOOTSTRAP=true
    shift
fi

if [[ $# -ne 0 ]]; then
    echo "Verwendung: scripts/codex-sprint [--bootstrap]"
    exit 2
fi

for command in git codex python3; do
    if ! command -v "$command" >/dev/null 2>&1; then
        echo "Fehler: '$command' ist nicht installiert oder nicht im PATH."
        exit 1
    fi
done

if [[ ! -f SPRINT.md ]]; then
    echo "Fehler: SPRINT.md fehlt."
    exit 1
fi

SPRINT_ID="$(
    sed -nE 's/^#[[:space:]]+([A-Za-z0-9._-]+).*/\1/p' SPRINT.md |
    head -n 1
)"

if [[ -z "$SPRINT_ID" ]]; then
    echo "Fehler: Keine Sprint-ID in der ersten Überschrift von SPRINT.md gefunden."
    exit 1
fi

SLUG="$(
    printf '%s' "$SPRINT_ID" |
    tr '[:upper:]' '[:lower:]'
)"
BRANCH="codex/$SLUG"
BASE_BRANCH="$(git branch --show-current)"
REMOTE_NAME="backup"

if [[ -z "$BASE_BRANCH" ]]; then
    echo "Fehler: Detached HEAD ist nicht zulässig."
    exit 1
fi

if [[ "$BASE_BRANCH" == codex/* ]]; then
    echo "Fehler: Der Runner muss auf dem freigegebenen Arbeitsbranch gestartet werden."
    echo "Aktueller Branch: $BASE_BRANCH"
    exit 1
fi

if ! git remote get-url "$REMOTE_NAME" >/dev/null 2>&1; then
    echo "Fehler: Git-Remote '$REMOTE_NAME' fehlt."
    exit 1
fi

python3 - "$BOOTSTRAP" <<'PY'
import subprocess
import sys

bootstrap = sys.argv[1].lower() == "true"
allowed = {"SPRINT.md"}

if bootstrap:
    allowed.update(
        {
            "AGENTS.md",
            "CODING_RULES.md",
            "dev",
            "docs/ARCHITECTURE.md",
            "docs/DEPLOYMENT.md",
            "docs/DEVELOPMENT.md",
            "docs/TESTING.md",
            "scripts/build-project",
            "scripts/check",
            "scripts/codex-sprint",
            "scripts/status",
        }
    )

raw = subprocess.check_output(
    ["git", "status", "--porcelain=v1", "-z", "--untracked-files=all"]
)

unexpected = []
for entry in raw.split(b"\0"):
    if not entry:
        continue

    status = entry[:2].decode("ascii", errors="replace")
    path = entry[3:].decode("utf-8", errors="surrogateescape")

    if "R" in status or "C" in status:
        unexpected.append(f"{status} {path}")
        continue

    if path not in allowed:
        unexpected.append(f"{status} {path}")

if unexpected:
    print("ABBRUCH: Vor dem Sprint liegen unerwartete Änderungen vor:")
    print("\n".join(unexpected))
    raise SystemExit(1)
PY

if git show-ref --verify --quiet "refs/heads/$BRANCH"; then
    echo "Fehler: Lokaler Sprint-Branch existiert bereits: $BRANCH"
    exit 1
fi

if git ls-remote --exit-code --heads "$REMOTE_NAME" "$BRANCH" >/dev/null 2>&1; then
    echo "Fehler: Remote-Sprint-Branch existiert bereits: $BRANCH"
    exit 1
fi

RUN_DIR="$ROOT/.git/codex-runs/$SLUG"
mkdir -p "$RUN_DIR"

PROMPT_FILE="$RUN_DIR/prompt.txt"
CODEX_LOG="$RUN_DIR/codex.log"
LAST_MESSAGE="$RUN_DIR/last-message.md"
CHECK_LOG="$RUN_DIR/check.log"
REPORT_FILE="$RUN_DIR/commit-message.txt"

cat > "$PROMPT_FILE" <<EOF
Arbeite den in SPRINT.md beschriebenen Sprint $SPRINT_ID vollständig ab.

Lies zuerst AGENTS.md, CODING_RULES.md und die Dokumentation unter docs/.
Halte dich strikt an alle dort festgelegten Grenzen.

Verbindliche Regeln:
- keine Änderungen außerhalb dieses Repositories
- kein Zugriff auf Produktivdaten, Backups, Schlüssel oder Runtime-Dateien
- kein Deployment und kein Dienstneustart
- keine Git-Schreiboperationen: kein add, commit, push, merge, rebase, tag oder Branchwechsel
- führe die vorgesehenen Prüfungen tatsächlich aus
- behebe Probleme nur innerhalb des vereinbarten Sprintumfangs
- eine durch die Sandbox blockierte Netzwerkprüfung ist klar als solche zu melden
- ändere Prüfungen niemals nur deshalb, damit ein fehlerhafter Stand grün erscheint

Liefere am Ende:
1. geänderte Dateien
2. ausgeführte Befehle
3. Ergebnisse der Prüfungen
4. offene Probleme und empfohlene Folgeschritte
5. vollständigen Git-Status
EOF

echo "============================================================"
echo "CODEX-SPRINT: $SPRINT_ID"
echo "Basisbranch:  $BASE_BRANCH"
echo "Sprintbranch: $BRANCH"
echo "============================================================"

git switch -c "$BRANCH"

set +e
GRADLE_USER_HOME="$ROOT/.gradle/codex-user-home" \
codex exec \
    --sandbox workspace-write \
    --ask-for-approval never \
    --output-last-message "$LAST_MESSAGE" \
    - < "$PROMPT_FILE" 2>&1 |
tee "$CODEX_LOG"
CODEX_EXIT=${PIPESTATUS[0]}
set -e

if [[ ! -s "$LAST_MESSAGE" ]]; then
    printf '%s\n' \
        "Codex hat keine abschließende Nachricht geschrieben." \
        > "$LAST_MESSAGE"
fi

echo
echo "============================================================"
echo "PRÜFUNGEN AUSSERHALB DER CODEX-SANDBOX"
echo "============================================================"

set +e
GRADLE_USER_HOME="$HOME/.gradle" \
scripts/check 2>&1 |
tee "$CHECK_LOG"
CHECK_EXIT=${PIPESTATUS[0]}
set -e

git add -A

python3 - <<'PY'
import subprocess

forbidden_parts = {
    ".env",
    "database.db",
    "runtime",
    "runtime-original",
    "backup",
    "backups",
    "keys",
}
forbidden_suffixes = (".db", ".jks", ".key", ".pem", ".p12", ".pfx")

raw = subprocess.check_output(
    ["git", "diff", "--cached", "--name-only", "-z"]
)

bad = []
for item in raw.split(b"\0"):
    if not item:
        continue
    path = item.decode("utf-8", errors="surrogateescape")
    parts = set(path.split("/"))
    name = path.rsplit("/", 1)[-1]

    if parts & forbidden_parts:
        bad.append(path)
    elif name.endswith(forbidden_suffixes):
        bad.append(path)

if bad:
    print("ABBRUCH: Verbotene oder sensible Dateien sind vorgemerkt:")
    print("\n".join(sorted(set(bad))))
    raise SystemExit(1)
PY

git diff --cached --check

if [[ $CODEX_EXIT -eq 0 && $CHECK_EXIT -eq 0 ]]; then
    RESULT="ERFOLGREICH"
    SUBJECT="chore(codex): complete $SPRINT_ID"
else
    RESULT="PRÜFUNG FEHLGESCHLAGEN"
    SUBJECT="chore(codex): capture $SPRINT_ID with failed checks"
fi

{
    echo "$SUBJECT"
    echo
    echo "Automatischer Codex-Sprintbericht"
    echo
    echo "Sprint: $SPRINT_ID"
    echo "Basisbranch: $BASE_BRANCH"
    echo "Sprintbranch: $BRANCH"
    echo "Ergebnis: $RESULT"
    echo "Codex-Exitcode: $CODEX_EXIT"
    echo "Post-Check-Exitcode: $CHECK_EXIT"
    echo
    echo "Geänderte Dateien:"
    git diff --cached --name-status
    echo
    echo "Diff-Statistik:"
    git diff --cached --stat
    echo
    echo "Codex-Abschlussbericht:"
    echo
    cat "$LAST_MESSAGE"
    echo
    echo "Letzte Zeilen der Prüfung außerhalb der Sandbox:"
    echo
    tail -n 160 "$CHECK_LOG"
} > "$REPORT_FILE"

git commit -S -F "$REPORT_FILE"
git push -u "$REMOTE_NAME" "HEAD:$BRANCH"

echo
echo "============================================================"
echo "SPRINT AUF GITHUB ÜBERGEBEN"
echo "============================================================"
echo "Sprint: $SPRINT_ID"
echo "Branch: $BRANCH"
echo "Commit: $(git rev-parse HEAD)"
echo "Codex-Exitcode: $CODEX_EXIT"
echo "Post-Check-Exitcode: $CHECK_EXIT"
echo
echo "Im Chat genügt jetzt: Sprint $SPRINT_ID fertig"
